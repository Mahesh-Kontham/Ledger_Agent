GEMINI_API_KEY=               # required (Google AI Studio key)
GEMINI_MODEL=                 # optional; default gemini-3.5-flash
FRAUD_MCP_URL=                # optional; if empty, use MockFraudChecker
GMAIL_IMAP_USER=              # optional; if empty, email source reads sample_data/inbox/*.eml
GMAIL_IMAP_APP_PASSWORD=      # optional
DEMO_ADMIN_PW=                # demo admin@demo password (min 8 chars)
DEMO_BUSINESS_PW=             # demo business@demo password
DEMO_USER_PW=                 # demo user@demo password
